APP_NAME="AI Customer Support Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT=local-dev
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ALEMBIC_DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma_db
UPLOAD_DIR=./data/uploads
SECRET_KEY=change-me-minimum-32-bytes
SESSION_TTL_SECONDS=86400
QUERY_CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=52428800
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:8080
LOCAL_LLM_HF_REPO=unsloth/gemma-4-E2B-it-GGUF
LOCAL_LLM_MODEL=gemma-4-E2B-it-Q4_K_M.gguf
LOCAL_LLM_CACHE_RAM_MB=2048
LOCAL_LLM_CONTEXT_PARALLEL=2
LOCAL_LLM_CONTEXT_SIZE=2048
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
